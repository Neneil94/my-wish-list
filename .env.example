# Öffentliche Werte aus dem Supabase-Dashboard (Project Settings → API).
# Der anon/publishable Key ist absichtlich öffentlich – Schutz erfolgt über RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: Angaben für die Seite „Hinweise & Datenschutz“ (#/legal).
# Nicht ins Repository schreiben – im GitHub-Environment "github-pages" als Variablen hinterlegen.
# Ohne Angabe wird auf „die Person, die das Zugangspasswort weitergegeben hat“ verwiesen.
VITE_OPERATOR_NAME=
VITE_OPERATOR_CONTACT=
# Region des Supabase-Projekts (Project Settings → General), z. B. "EU (Frankfurt)"
VITE_DATA_REGION=
