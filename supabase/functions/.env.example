# Secrets für die Edge Function "account":
#   cp supabase/functions/.env.example supabase/functions/.env.production
#   npx supabase@3.0.0 secrets set --env-file supabase/functions/.env.production
#
# Ausgabe von "node scripts/hash-access-code.mjs" – unbedingt in einfachen Anführungszeichen ($-Zeichen!)
ACCESS_CODE_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# Zufälliger Wert, z. B. "openssl rand -hex 32"
RATE_LIMIT_SALT=bitte-ersetzen
# Erlaubte Browser-Origins (ohne Pfad), kommagetrennt
ALLOWED_ORIGINS=https://neneil94.github.io
